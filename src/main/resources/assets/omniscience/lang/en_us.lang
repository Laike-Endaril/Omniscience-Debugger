omnisciencedebugger.literal1=%s



omnisciencedebugger.cmd.threads.comment=§dShows info for all threads; id, name, cpu, heap allocation (cpu and heap are running totals; GC removals are not accounted for)
omnisciencedebugger.cmd.threads.comment2=§dShows detailed info for the thread with the given id
omnisciencedebugger.cmd.threads.comment3=§cUNSAFE! - Stops the given thread

omnisciencedebugger.cmd.nbt.comment=§dShows all NBT in the item in your main hand
omnisciencedebugger.cmd.nbt.comment2=§dShows all NBT in YOU
omnisciencedebugger.cmd.nbt.comment3=§cShows all NBT in the nearest entity

omnisciencedebugger.cmd.profiling.comment=§dToggles entity-based profiling
omnisciencedebugger.cmd.profiling.comment2=§dToggles tile-entity-based profiling
omnisciencedebugger.cmd.profiling.comment3=§dToggles event-based profiling
omnisciencedebugger.cmd.profiling.comment4=§dToggles event-object-based profiling
omnisciencedebugger.cmd.profiling.comment5=§dToggles event-method-based profiling

omnisciencedebugger.cmd.memory.comment=§dShows basic JVM memory usage data

omnisciencedebugger.cmd.entities.comment=§dShows how many entities are currently loaded

omnisciencedebugger.cmd.pathing.comment=§dShows or hides the path of the nearest entity
omnisciencedebugger.cmd.pathing.start=§aPathing is now visible for %s @ %s, %s, %s
omnisciencedebugger.cmd.pathing.stop=§cPathing is no longer visible for %s @ %s, %s, %s

omnisciencedebugger.cmd.ai.comment=§dShows the AI tasks of the nearest entity

omnisciencedebugger.cmd.codeprinter.comment=§dToggles whether currently running code is printed to the log when massive lag happens



omnisciencedebugger.ccmd.screens.comment=§dShows info on recently shown GuiScreens

omnisciencedebugger.ccmd.nbt.comment=§dShows all NBT in the item in your main hand
omnisciencedebugger.ccmd.nbt.comment2=§dShows all NBT in YOU
omnisciencedebugger.ccmd.nbt.comment3=§cShows all NBT in the nearest entity



omnisciencedebugger.error.threads.notFound=§cThread not found: %s

omnisciencedebugger.error.notPlayer=§cOnly players can use the "%s" subcommand
omnisciencedebugger.error.noEntityFound=§cNo entities found nearby

omnisciencedebugger.error.profilerRunning=§cCannot do this while the profiler is running



